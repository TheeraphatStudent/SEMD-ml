MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_CONTAINER_TRACKING_URI=http://mlflow:5000
# semd-url-classification (no suffix) predates the mlflow-artifacts:/ proxy fix and has a bare
# filesystem artifact_location baked in permanently — MLflowTracker refuses to reuse it (see
# docs/section-10-infrastructure-validation.md, Remaining Blocker #1). Use a versioned name for
# any new experiment; bump the suffix again if this one ever needs replacing the same way.
MLFLOW_EXPERIMENT_NAME=semd-url-classification-v2
MLFLOW_REGISTERED_MODEL_NAME=semd-malicious-url-detector
# Informational only — recorded into training_configuration.json metadata. Actual artifact
# storage is controlled server-side by the mlflow container's --default-artifact-root/
# --artifacts-destination flags (docker/docker-compose.yml), which proxy all reads/writes
# through the tracking server's HTTP API so client containers never need direct filesystem
# access to the artifact store. See docs/section-10-infrastructure-validation.md.
MLFLOW_ARTIFACT_ROOT=mlflow-artifacts:/
MLFLOW_ALIAS_CANDIDATE=candidate
MLFLOW_ALIAS_CHAMPION=champion
MLFLOW_ALIAS_PREVIOUS_CHAMPION=previous-champion

# Local fallback is disabled by default; only enable it with all four values set (see docs/model-serving.md)
MLFLOW_LOCAL_FALLBACK_ENABLED=false
MLFLOW_LOCAL_FALLBACK_MODEL_PATH=
MLFLOW_LOCAL_FALLBACK_MODEL_VERSION=
MLFLOW_LOCAL_FALLBACK_MODEL_NAME=

# Promotion gates and comparison policy (see docs/model-registry.md)
MODEL_PROMOTION_GATES={"malicious_recall":{"operator":">=","threshold":0.95},"malicious_f1":{"operator":">=","threshold":0.93},"false_negative_rate":{"operator":"<=","threshold":0.05},"prediction_latency_ms":{"operator":"<=","threshold":200.0}}
PROMOTION_REQUIRE_CHAMPION_COMPARISON=true
PROMOTION_SMOKE_TEST_URLS=["https://example.com","http://secure-login.bad-example.net/verify"]

# Must match semd-backend's redis requirepass (semd-backend/config/redis.conf) and
# backend.ini's [REDIS] PASSWORD — both services share one Redis instance/container.
# Leave blank only if the shared Redis has no requirepass configured.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=semd_db

LOG_LEVEL=INFO
ENABLE_FEATURE_IMPORTANCE=true

# Only needed by dataset/script/cloudflare_client.py (data-migrate sourcing)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Prediction monitoring store (see docs/monitoring.md). Defaults resolve under the repo root; uncomment and set
# only to relocate the SQLite store or feedback-derived dataset staging directory (an empty value would override
# the code default with an unusable empty path, so these are commented out rather than left blank).
# MONITORING_DB_PATH=/absolute/path/to/monitoring.db
# MONITORING_DATASET_DIR=/absolute/path/to/monitoring/datasets
