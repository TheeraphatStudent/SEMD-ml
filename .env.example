MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_CONTAINER_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=semd-url-classification
MLFLOW_REGISTERED_MODEL_NAME=semd-malicious-url-detector
MLFLOW_ARTIFACT_ROOT=./artifacts/mlflow
MLFLOW_ALIAS_CANDIDATE=candidate
MLFLOW_ALIAS_CHAMPION=champion
MLFLOW_ALIAS_PREVIOUS_CHAMPION=previous-champion

# Local fallback is disabled by default; only enable it with all four values set (see docs/model-serving.md)
MLFLOW_LOCAL_FALLBACK_ENABLED=false
MLFLOW_LOCAL_FALLBACK_MODEL_PATH=
MLFLOW_LOCAL_FALLBACK_MODEL_VERSION=
MLFLOW_LOCAL_FALLBACK_MODEL_NAME=

# Promotion gates and comparison policy (see docs/model-registry.md)
MODEL_PROMOTION_GATES={"malicious_recall":{"operator":">=","threshold":0.95},"malicious_f1":{"operator":">=","threshold":0.93},"false_negative_rate":{"operator":"<=","threshold":0.05},"prediction_latency_ms":{"operator":"<=","threshold":200.0}}
PROMOTION_REQUIRE_CHAMPION_COMPARISON=true
PROMOTION_SMOKE_TEST_URLS=["https://example.com","http://secure-login.bad-example.net/verify"]

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=semd_db

LOG_LEVEL=INFO
ENABLE_FEATURE_IMPORTANCE=true

# Only needed by dataset/script/cloudflare_client.py (data-migrate sourcing)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
